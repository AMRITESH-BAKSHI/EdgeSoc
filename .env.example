# EdgeSOC - Backend / Python environment variables
# Copy this file to `.env` (same folder as config.py, project root) and
# adjust values for your deployment. Never commit the real `.env` file.

# Ollama (must be reachable from wherever backend/main.py runs)
OLLAMA_URL=http://localhost:11434/api/chat
MODEL_NAME=llama3.2:1b

# Frontend URL, used by backend/routes/health.py to ping the dashboard.
# Only needs to change if frontend and backend run on different hosts.
FRONTEND_URL=http://localhost:3000

# Detection thresholds
BRUTE_FORCE_THRESHOLD=3
DDOS_THRESHOLD=5
DDOS_TIME_WINDOW=60

# CORS - comma-separated list of origins allowed to call the backend API.
# Set this to wherever the frontend is actually served from, e.g.:
# ALLOWED_ORIGINS=http://192.168.1.50:3000
ALLOWED_ORIGINS=http://localhost:3000
